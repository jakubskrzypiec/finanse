 .faq-item { border-bottom: 1px solid var(--line); }
 .faq-item h3 { margin: 0; }
-.faq-button { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 20px 0; border: 0; background: transparent; color: var(--ink); text-align: left; font-size: .98rem; font-weight: 700; cursor: pointer; }
-.faq-button svg { width: 20px; height: 20px; flex: 0 0 auto; fill: none; stroke: var(--blue); stroke-width: 1.6; transition: transform .22s var(--ease); }
